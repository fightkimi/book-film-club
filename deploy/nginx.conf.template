limit_req_zone $binary_remote_addr zone=tongpin_auth:10m rate=10r/m;
server {
    listen 80;
    server_name SERVER_ADDRESS;
    location /.well-known/acme-challenge/ { root /var/www/tongpin-acme; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name SERVER_ADDRESS;
    ssl_certificate /etc/letsencrypt/live/SERVER_ADDRESS/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/SERVER_ADDRESS/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=86400" always;
    client_max_body_size 150k;
    location ~ ^/api/(login|setup)$ {
        limit_req zone=tongpin_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
