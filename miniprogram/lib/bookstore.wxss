.book-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 28rpx;
}
.book-head .title {
  min-width: 0;
  margin: 0;
}
.city-nav {
  display: flex;
  gap: 26rpx;
  align-items: center;
  margin: 20rpx 0 28rpx;
}
.city-nav navigator {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #777;
}
.shop-item {
  display: block;
  margin: 0 0 40rpx;
}
.shop-photo {
  width: 100%;
  height: 310rpx;
  display: block;
  background: #f4f4f0;
}
.shop-name {
  font-family: "Songti SC", serif;
  font-size: 40rpx;
  line-height: 1.4;
  margin: 9rpx 0;
}
.shop-photo + .muted {
  margin-top: 12rpx;
}
.photo-strip {
  white-space: nowrap;
  margin: 22rpx 0;
}
.photo-strip image {
  width: 80%;
  height: 320rpx;
  display: inline-block;
  margin-right: 12rpx;
}
.area {
  box-sizing: border-box;
  min-height: 120rpx;
  width: 100%;
  border: 1rpx solid #ccc;
  padding: 16rpx;
}
.topic {
  display: block;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ddd;
}
.topic text {
  display: block;
}
.store-form button,
.store-form navigator,
.entry-link {
  margin-top: 18rpx;
}
.entry-link {
  display: block;
  padding: 16rpx 0;
  color: #345647;
}
.message {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.code {
  font-family: monospace;
  letter-spacing: 3rpx;
}
.book-filters {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 12rpx;
  margin: 24rpx 0;
}
.book-filters button.district-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  min-height: 58rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 25rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.book-filters .district-label { display: block; line-height: 1.25; }
.book-head .compose-button {
  flex: none;
  width: auto;
  min-width: 64px;
  min-height: 44px;
  margin: 0;
  padding: 0 14px;
  border: 1px solid #bcc4bd;
  box-sizing: border-box;
  white-space: nowrap;
}

.city-select { padding: 12rpx 16rpx 12rpx 0; font-size: 34rpx; font-weight: 500; }
