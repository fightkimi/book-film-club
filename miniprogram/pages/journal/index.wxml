<view class="page"><view class="subtitle">这些记录仅自己可见，不会公开为小组影评。</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="eyebrow">{{item.provider}}</view><view class="card-title">{{item.title}}</view><view class="muted">{{item.date||'日期未提供'}} · {{item.rating===null?'未评分':item.rating+' / 5'}} · {{item.statusLabel}}</view><button wx:if="{{item.body&&!revealed[item.id]}}" class="quiet" data-id="{{item.id}}" bindtap="reveal">查看原始感想（可能含剧透）</button><view wx:if="{{revealed[item.id]}}" class="prewrap">{{item.body}}</view><option-picker title="选择关联作品" range="{{item.choices}}" range-key="title" value="{{item.index}}" data-row="{{index}}" bindchange="link"><view class="picker">{{item.choices[item.index].title}}</view></option-picker><button wx:if="{{!item.work_id}}" class="quiet" data-row="{{index}}" bindtap="search">搜索补全资料</button></view><view wx:if="{{!rows.length}}" class="empty">还没有导入记录。</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
