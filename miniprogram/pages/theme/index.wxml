<view class="page"><view class="eyebrow">THEME ARCHIVE</view><view class="title">{{theme.title}}</view><view class="subtitle">{{theme.description}}</view><view class="section-title">从哪些角度进入</view><view class="prewrap">{{theme.angles||'尚未添加讨论角度。'}}</view><view class="actions"><button bindtap="recommend">挑选作品</button><button wx:if="{{isAdmin}}" class="secondary" bindtap="create">以此发起活动</button></view><view wx:if="{{isAdmin}}" class="actions"><button class="secondary" bindtap="edit">编辑主题</button><button class="secondary" disabled="{{busy||!services.ai}}" bindtap="analyze">AI 解构</button></view><view wx:if="{{draft}}" class="note-box"><view class="prewrap">{{draft.analysis}}</view><button class="secondary" bindtap="adopt">编辑并采用</button><view wx:for="{{draft.recommendations}}" wx:key="title" class="card"><view>{{item.title}}</view><view class="muted">{{item.reason}}</view></view></view><view class="section-title">这个主题的活动</view><view wx:for="{{cycles}}" wx:key="id" class="card" data-page="cycle" data-id="{{item.id}}" bindtap="open"><view>{{item.title}}</view><view class="muted">{{item.statusLabel}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
