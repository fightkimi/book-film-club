<view wx:if="{{authorized && item}}" class="page with-dock personal-form"><view class="muted">{{item.kindLabel}}</view><view class="title">{{item.title}}</view><view class="subtitle">{{item.creator}}</view>
 <button class="record-toggle" bindtap="toggleProgress" aria-expanded="{{progressOpen}}"><text>{{statuses[statusIndex]}}{{item.kind==='book' && statusIndex===1?'　'+progress+'%':''}}{{ratingIndex?'　'+ratings[ratingIndex]+' / 5':''}}</text><text>进度、评分与计划 {{progressOpen?'−':'＋'}}</text></button>
 <block wx:if="{{progressOpen}}"> <view class="inline-controls"><month-picker value="{{month}}" bindchange="month"><view class="picker plan-month-field">{{month}}</view></month-picker><button class="secondary" bindtap="plan" disabled="{{busy}}">{{planned?'移出本月计划':'加入本月计划'}}</button></view>
 <block wx:if="{{item.source==='weread'}}"><view class="switch-row"><text>跟随微信读书进度</text><switch color="#252525" checked="{{tracking}}" bindchange="tracking"/></view><button class="secondary" bindtap="sync" disabled="{{busy}}" loading="{{busy}}">同步阅读进度</button><view wx:if="{{item.wr_synced}}" class="muted">最近同步 {{item.wr_synced}}</view></block>
 <view class="label">状态</view><option-picker title="阅读或观看状态" range="{{statuses}}" value="{{statusIndex}}" disabled="{{busy || tracking}}" bindchange="status"><view class="picker">{{statuses[statusIndex]}}</view></option-picker>
 <block wx:if="{{item.kind==='book'}}"><view class="label">读到 {{progress}}%</view><input wx:if="{{!tracking && statusIndex!==2}}" class="field" type="number" value="{{progress}}" data-key="progress" bindinput="input" maxlength="3"/><progress wx:else percent="{{statusIndex===2?100:progress}}" stroke-width="3" activeColor="#252525"/></block>
 <block wx:if="{{statusIndex===2}}"><view class="label">{{item.kind==='book'?'读完日期':'观看日期'}}</view><picker mode="date" value="{{finished}}" bindchange="date" disabled="{{tracking}}"><view class="picker">{{tracking&&!item.finished_at?'完成日期未提供':finished}}</view></picker></block>
 <view class="label">我的评分（可选）</view><option-picker title="我的评分" range="{{ratings}}" value="{{ratingIndex}}" bindchange="rating"><view class="picker">{{ratings[ratingIndex]}}{{ratingIndex?' / 5':''}}</view></option-picker>
</block>
 <view class="reflection-heading"><view class="section-title">我的感想</view><text class="muted">仅自己可见</text></view>
 <text wx:if="{{!writing && reflection}}" class="reflection-full" selectable>{{reflection}}</text>
 <button wx:if="{{!writing && reflection}}" class="secondary continue-writing" bindtap="continueWriting">继续写</button>
 <block wx:if="{{writing}}">
 <view class="reflection-field {{reviewExpanded?'expanded':''}}"><textarea class="reflection-editor" value="{{reflection}}" bindinput="editReflection" maxlength="12000" auto-height disable-default-padding disabled="{{busy}}" placeholder="写下一句话，也可以慢慢写成长评" placeholder-class="reflection-placeholder" cursor-spacing="150"/></view>
  <view class="reflection-toolbar"><button class="quiet" bindtap="toggleReview" aria-expanded="{{reviewExpanded}}">{{reviewExpanded?'收起写作工具':item.kind==='book'?'展开写书评':'展开写影评'}}</button><text class="muted">{{reflection.length}} / 12000</text></view>
  <block wx:if="{{reviewExpanded}}">
   <view wx:if="{{item.kind==='book'}}" class="review-notes-section"><view class="review-notes-heading"><view class="section-title">阅读笔记{{note_count?'（'+note_count+'）':''}}</view><button wx:if="{{can_sync_notes}}" class="quiet" bindtap="syncNotes" disabled="{{busy}}">更新笔记</button></view>
    <navigator wx:if="{{!connection.connected}}" class="entry-link" url="/pages/personal-connect/index">连接微信读书 ›</navigator><view wx:elif="{{!notes_supported}}" class="private-hint">暂未关联微信读书版本</view><view wx:if="{{noteError}}" class="error">{{noteError}}</view>
    <button wx:if="{{reviewNotes.length}}" class="quiet note-materials" bindtap="toggleNotes">{{notesOpen?'收起笔记':'引用笔记 / 选作 AI 材料'}}{{noteIds.length?'（已选 '+noteIds.length+' 条）':''}}</button>
    <checkbox-group wx:if="{{notesOpen}}" bindchange="chooseNotes"><view wx:for="{{reviewNotes}}" wx:key="id" class="review-note"><label><checkbox checked="{{item.checked}}" value="{{item.id}}" color="#202020"/><view><view class="muted">{{item.typeLabel}}　{{item.chapter}}</view><view class="review-note-body">{{item.body}}</view></view></label><button class="quiet quote-note" data-id="{{item.id}}" bindtap="quoteNote" disabled="{{busy}}">引用到正文</button></view></checkbox-group>
    <button wx:if="{{notesOpen && note_count>reviewNotes.length}}" class="quiet" bindtap="moreNotes">更多笔记</button><view wx:if="{{can_sync_notes && !note_count && !noteError}}" class="private-hint">还没有划线或想法</view>
   </view>
   <button class="secondary review-assist" disabled="{{busy || !aiReady || (!reflection && !noteIds.length)}}" loading="{{busy}}" bindtap="assist">{{reflection?'AI 帮我梳理':item.kind==='book'?'用所选笔记起草':'AI 帮我梳理影评'}}</button>
  </block>
 </block>
 <view wx:if="{{aiDraft}}" class="note-box"><view class="muted">AI 草稿</view><view class="prewrap">{{aiDraft.polished}}</view><view wx:if="{{aiDraft.questions.length}}" class="label">还可以补充</view><view wx:for="{{aiDraft.questions}}" wx:key="index">{{item}}</view><view wx:for="{{aiDraft.evidence}}" wx:key="index" class="muted">「{{item.quote}}」</view><button class="secondary" bindtap="adoptReview">放入编辑框</button></view>
 <button wx:if="{{beforeAdoption!==null}}" class="quiet" bindtap="restoreReview">恢复采用前的文字</button>
 <view class="personal-links"><text bindtap="notes">我的笔记{{note_count?'（'+note_count+'）':''}} ›</text><text wx:if="{{item.reflection}}" bindtap="share">选一段分享 ›</text></view>
 <block wx:if="{{history.length}}"><view class="section-title">读过，看过</view><view wx:for="{{history}}" wx:key="id" class="personal-history"><view class="muted">{{item.finished_at||'完成日期未记录'}}{{item.rating?'　'+item.rating+' / 5':''}}</view><view wx:if="{{item.reflection}}" class="prewrap">{{item.reflection}}</view></view></block>
 <view wx:if="{{error}}" class="error">{{error}} <text bindtap="reload">重新载入</text></view></view><view wx:if="{{authorized}}" class="dock"><button bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存记录</button></view><view wx:if="{{!authorized && error}}" class="error">{{error}} <text bindtap="load">重试</text></view>
