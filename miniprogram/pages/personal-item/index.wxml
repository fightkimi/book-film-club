<view wx:if="{{authorized && item}}" class="page with-dock personal-form"><view class="muted">{{item.kindLabel}}　仅自己可见</view><view class="title">{{item.title}}</view><view class="subtitle">{{item.creator}}</view>
 <button class="record-toggle" bindtap="toggleProgress" aria-expanded="{{progressOpen}}"><text>{{statuses[statusIndex]}}{{item.kind==='book' && statusIndex===1?'　'+progress+'%':''}}{{ratingIndex?'　'+ratings[ratingIndex]+' / 5':''}}</text><text>进度、评分与计划 {{progressOpen?'−':'＋'}}</text></button>
 <block wx:if="{{progressOpen}}"> <view class="inline-controls"><month-picker value="{{month}}" bindchange="month"><view class="picker plan-month-field">{{month}}</view></month-picker><button class="secondary" bindtap="plan" disabled="{{busy}}">{{planned?'移出本月计划':'加入本月计划'}}</button></view>
 <block wx:if="{{item.source==='weread'}}"><view class="switch-row"><text>跟随微信读书进度</text><switch color="#252525" checked="{{tracking}}" bindchange="tracking"/></view><button class="secondary" bindtap="sync" disabled="{{busy}}" loading="{{busy}}">同步阅读进度</button><view wx:if="{{item.wr_synced}}" class="muted">最近同步 {{item.wr_synced}}</view></block>
 <view class="label">状态</view><option-picker title="阅读或观看状态" range="{{statuses}}" value="{{statusIndex}}" disabled="{{busy || tracking}}" bindchange="status"><view class="picker">{{statuses[statusIndex]}}</view></option-picker>
 <block wx:if="{{item.kind==='book'}}"><view class="label">读到 {{progress}}%</view><input wx:if="{{!tracking && statusIndex!==2}}" class="field" type="number" value="{{progress}}" data-key="progress" bindinput="input" maxlength="3"/><progress wx:else percent="{{statusIndex===2?100:progress}}" stroke-width="3" activeColor="#252525"/></block>
 <block wx:if="{{statusIndex===2}}"><view class="label">{{item.kind==='book'?'读完日期':'观看日期'}}</view><picker mode="date" value="{{finished}}" bindchange="date" disabled="{{tracking}}"><view class="picker">{{tracking&&!item.finished_at?'完成日期未提供':finished}}</view></picker></block>
 <view class="label">我的评分（可选）</view><option-picker title="我的评分" range="{{ratings}}" value="{{ratingIndex}}" bindchange="rating"><view class="picker">{{ratings[ratingIndex]}}{{ratingIndex?' / 5':''}}</view></option-picker>
</block>
 <view class="label">{{item.kind==='book'?'我的书评':'我的影评'}}</view><textarea class="textarea" value="{{reflection}}" data-key="reflection" bindinput="input" maxlength="12000" placeholder="留下一点自己的看法" cursor-spacing="120"/>
 <view wx:if="{{item.kind==='book'}}" class="review-notes-section"><view class="review-notes-heading"><view class="section-title">阅读笔记{{note_count?'（'+note_count+'）':''}}</view><button wx:if="{{can_sync_notes}}" class="quiet" bindtap="syncNotes" disabled="{{busy}}">更新笔记</button></view><navigator wx:if="{{!connection.connected}}" class="entry-link" url="/pages/personal-connect/index">连接微信读书，同步本书笔记 ›</navigator><view wx:elif="{{!notes_supported}}" class="private-hint">这条记录还没有对应的微信读书版本</view><view wx:if="{{noteError}}" class="error" bindtap="syncNotes">{{noteError}}</view>
 <view wx:if="{{reviewNotes.length && !notesOpen}}" class="review-latest"><view class="review-note-body">{{reviewNotes[0].body}}</view></view><button wx:if="{{reviewNotes.length}}" class="quiet note-materials" bindtap="toggleNotes">{{notesOpen?'收起笔记':'选笔记辅助书评'}}{{noteIds.length?'（已选 '+noteIds.length+' 条）':''}}</button><checkbox-group wx:if="{{notesOpen}}" bindchange="chooseNotes"><label wx:for="{{reviewNotes}}" wx:key="id" class="review-note"><checkbox checked="{{item.checked}}" value="{{item.id}}" color="#202020"/><view><view class="muted">{{item.typeLabel}}　{{item.chapter}}</view><view class="review-note-body">{{item.body}}</view></view></label></checkbox-group><button wx:if="{{notesOpen && note_count>reviewNotes.length}}" class="quiet" bindtap="moreNotes">更多笔记</button><view wx:if="{{can_sync_notes && !note_count && !noteError}}" class="private-hint">本书暂时没有划线或想法</view></view>
 <button class="secondary review-assist" disabled="{{busy || !aiReady || (!reflection && !noteIds.length)}}" loading="{{busy}}" bindtap="assist">{{reflection?'AI 帮我整理文字':item.kind==='book'?'用笔记起草书评':'AI 帮我整理影评'}}{{noteIds.length?'（'+noteIds.length+' 条）':''}}</button><view wx:if="{{aiDraft}}" class="note-box"><view class="muted">AI 草稿</view><view class="prewrap">{{aiDraft.polished}}</view><view wx:if="{{aiDraft.questions.length}}" class="label">还可以补充</view><view wx:for="{{aiDraft.questions}}" wx:key="index">{{item}}</view><view wx:for="{{aiDraft.evidence}}" wx:key="index" class="muted">「{{item.quote}}」</view><button class="secondary" bindtap="adoptReview">放入编辑框</button></view><button wx:if="{{beforeAdoption!==null}}" class="quiet" bindtap="restoreReview">恢复采用前的文字</button>
 <view class="personal-links"><text bindtap="notes">我的笔记{{note_count?'（'+note_count+'）':''}} ›</text><text wx:if="{{item.reflection}}" bindtap="share">选一段分享 ›</text></view>
 <block wx:if="{{history.length}}"><view class="section-title">读过，看过</view><view wx:for="{{history}}" wx:key="id" class="personal-history"><view class="muted">{{item.finished_at||'完成日期未记录'}}{{item.rating?'　'+item.rating+' / 5':''}}</view><view wx:if="{{item.reflection}}" class="prewrap">{{item.reflection}}</view></view></block>
 <view wx:if="{{error}}" class="error">{{error}} <text bindtap="reload">重新载入</text></view></view><view wx:if="{{authorized}}" class="dock"><button bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存记录</button></view><view wx:if="{{!authorized && error}}" class="error">{{error}} <text bindtap="load">重试</text></view>
