<view class="page"><view class="section-title">修改小组账号密码</view><view class="label">当前密码</view><input class="field" password="{{true}}" value="{{current}}" data-field="current" bindinput="input"/><view class="label">新密码（至少 10 位）</view><input class="field" password="{{true}}" value="{{credential}}" data-field="credential" bindinput="input"/><view class="actions"><button bindtap="save" disabled="{{busy}}" loading="{{busy}}">更新密码</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="section-title">当前连接</view><view class="muted">{{baseUrl}}</view><view class="muted">服务密钥保存在后端，不在小程序中配置。</view></view>
