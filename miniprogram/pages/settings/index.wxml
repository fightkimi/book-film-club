<view class="page">
  <view class="section-title">我的账号</view>
  <view class="fact"><text class="fact-label">成员</text><text>{{user.name}}</text></view>
  <view class="fact"><text class="fact-label">小组</text><text>{{group}}</text></view>
  <view class="fact"><text class="fact-label">登录方式</text><text>微信登录</text></view>
  <view class="section-title">数据与工具</view><mp-cells><mp-cell value="导入的旧记录" link bindtap="importedRecords"/><mp-cell value="数据导入与进阶工具" link bindtap="tools"/></mp-cells>
  <button class="secondary logout" bindtap="logout">退出登录</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
