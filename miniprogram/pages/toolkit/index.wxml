<view class="page"><view class="title">导入与工具</view><scroll-view scroll-x class="tab-scroll"><view wx:for="{{tabs}}" wx:key="*this" class="tab-item {{tab===index?'active':''}}" data-index="{{index}}" bindtap="tab">{{item}}</view></scroll-view><view wx:if="{{tab===0}}"><mp-cells title="把看过的带过来"><mp-cell value="导入豆瓣书影音" link data-provider="douban" bindtap="importFile"/><mp-cell value="导入 Letterboxd 日记" link data-provider="letterboxd" bindtap="importFile"/><mp-cell value="Trakt 记录与想看片单" link data-provider="trakt" bindtap="importFile"/><mp-cell value="TMDB 高分电影榜" link bindtap="charts"/><mp-cell value="打开作品深读 / 逐镜记录" link bindtap="library"/></mp-cells><view class="section-title">保存的阅读与观影笔记</view><view wx:for="{{studies}}" wx:key="id" class="card" data-id="{{item.work_id}}" data-mode="{{item.mode}}" bindtap="notebook">{{item.title}} · {{item.mode==='shots'?'逐镜记录':'作品深读'}} →</view><view wx:if="{{!studies.length}}" class="muted">从作品详情开始记录观察。</view></view><view wx:if="{{tab===1}}"><view class="subtitle">个人档案仅自己可见，历史记录不会自动完成本期任务。</view><button class="secondary" bindtap="journal">查看 {{journals.length}} 条记录</button><button class="quiet" bindtap="exportData">导出旧档案与深读笔记</button></view><view wx:if="{{tab===2}}"><view wx:for="{{glossary}}" wx:key="name" class="card"><view class="card-title">{{item.name}}</view><view>{{item.definition}}</view><view class="muted">试着观察：{{item.observe}}</view></view></view><view wx:if="{{tab===3}}"><view wx:for="{{sourceRows}}" wx:key="name" class="card"><view class="between"><text class="card-title">{{item.name}}</text><text class="tag">{{item.ready?'已可用':'待配置'}}</text></view><view class="muted">{{item.what}}</view></view><view class="muted">This product uses the TMDB API but is not endorsed or certified by TMDB.</view><view class="muted">影片与图书资料由各平台提供，请核对具体版本与图片。</view></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
