<view class="page with-dock"><view wx:if="{{cycle}}" class="cover-row"><activity-cover cover="{{cycle.cover}}" title="{{cycle.title}}"/><view class="grow"><text class="tag">{{cycle.statusLabel}}</text><view class="title">{{cycle.title}}</view><view class="muted">{{cycle.startLabel}} — {{cycle.endLabel}}</view></view></view><view class="section-title">{{cycle.theme.title}}</view><view>{{cycle.direction||cycle.theme.description}}</view><view class="note-box">{{cycle.rules.quantity==='all'?'完成全部作品':'任选一部完成'}}{{cycle.rules.review?'，提交对应作品感想':''}}{{cycle.rules.discussion?'，参加讨论':''}}</view><view wx:if="{{isAdmin}}" class="actions"><button wx:if="{{cycle.status==='draft'}}" class="secondary" bindtap="edit">编辑活动</button><button wx:if="{{cycle.status==='draft'}}" data-status="active" bindtap="transition" disabled="{{busy}}">发布活动</button><button wx:if="{{cycle.status==='active'}}" class="secondary" data-status="closed" bindtap="transition" disabled="{{busy}}">结束活动</button><button wx:if="{{cycle.status==='closed'}}" class="secondary" data-status="archived" bindtap="transition" disabled="{{busy}}">归档活动</button></view><scroll-view scroll-x class="tab-scroll"><view wx:for="{{tabs}}" wx:key="*this" class="tab-item {{tab===index?'active':''}}" data-index="{{index}}" bindtap="tab">{{item}}</view></scroll-view>
<view wx:if="{{tab===0}}"><view wx:for="{{works}}" wx:key="id" class="card row" data-page="work" data-id="{{item.id}}" bindtap="open"><image class="list-cover" src="{{item.coverUrl}}" mode="aspectFit"/><view class="grow"><view class="card-title">{{item.title}}</view><view class="muted">{{item.creator}}</view></view></view><view wx:if="{{!works.length}}" class="empty">筹备中，尚未确定本期作品。</view><view wx:if="{{cycle.status==='draft'}}"><button class="secondary" bindtap="recommend">为本期挑选作品</button><view class="section-title">候选与投票</view><view wx:for="{{nominations}}" wx:key="id" class="card between"><view class="grow">{{item.title}}</view><button class="secondary" size="mini" data-id="{{item.id}}" disabled="{{busy||(!me&&!isAdmin)}}" bindtap="vote">{{item.voted?'撤回':'投票'}} · {{item.votes}}</button></view></view></view>
<view wx:if="{{tab===1}}"><button wx:if="{{me&&canWrite}}" class="secondary" bindtap="participation">我的参与与讨论状态</button><view wx:for="{{reports}}" wx:key="user_id" class="progress-card"><view class="between"><text>{{item.name}}</text><text class="tag">{{item.statusLabel}}</text></view><view class="muted">作品 {{item.completed}} / {{item.total}} · 感想 {{item.reviewed}} 篇</view></view></view>
<view wx:if="{{tab===2}}"><view wx:for="{{reviews}}" wx:key="id" class="card"><view>{{item.name}} · {{item.rating}} / 5</view><view class="muted">{{item.workTitle}}</view><button wx:if="{{item.spoiler&&!revealed[item.id]}}" class="quiet" data-id="{{item.id}}" bindtap="reveal">包含剧透，点击展开</button><view wx:else class="prewrap">{{item.body}}</view></view><view wx:if="{{!reviews.length}}" class="empty">还没有本期感想。</view></view>
<view wx:if="{{tab===3}}"><view class="prewrap">{{cycle.recap||'还没有整理回顾。'}}</view><view wx:if="{{cycle.recap_version!==cycle.content_version&&cycle.recap}}" class="notice">评价有更新，回顾可能需要重新整理。</view><button wx:if="{{isAdmin&&canWrite}}" class="secondary" bindtap="recap">编辑回顾</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view><view wx:if="{{me&&canWrite}}" class="dock"><button class="secondary" bindtap="progress">登记进度</button><button bindtap="review">写本期感想</button></view>
