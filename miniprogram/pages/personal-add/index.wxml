<view wx:if="{{authorized}}" class="page {{selected||source==='manual'?'with-dock':''}} personal-form"><view class="title">加入我的书影</view><view wx:if="{{!selected}}" class="personal-filters"><button size="mini" class="{{kind==='book'?'':'secondary'}}" data-kind="book" bindtap="kind" disabled="{{busy}}">书籍</button><button size="mini" class="{{kind==='movie'?'':'secondary'}}" data-kind="movie" bindtap="kind" disabled="{{busy}}">电影</button></view>
 <view wx:if="{{!selected}}" class="personal-tabs source-tabs"><button wx:if="{{kind==='book'}}" class="{{source==='weread'?'active':''}}" data-source="weread" bindtap="source" disabled="{{busy}}">我的书架</button><button wx:if="{{kind==='book'}}" class="{{source==='notebooks'?'active':''}}" data-source="notebooks" bindtap="source" disabled="{{busy}}">有笔记的书</button><button class="{{source==='catalog'?'active':''}}" data-source="catalog" bindtap="source" disabled="{{busy}}">书影资料库</button><button class="{{source==='manual'?'active':''}}" data-source="manual" bindtap="source" disabled="{{busy}}">手动添加</button></view>

 <block wx:if="{{source==='manual'}}"><view class="label">{{kind==='book'?'书名':'片名'}}</view><input class="field" value="{{title}}" data-key="title" bindinput="input" maxlength="400"/><view class="label">{{kind==='book'?'作者':'导演'}}</view><input class="field" value="{{creator}}" data-key="creator" bindinput="input" maxlength="300"/></block>
 <block wx:else><navigator wx:if="{{(source==='weread' || source==='notebooks') && !connection.connected}}" url="/pages/personal-connect/index" class="entry-link">连接自己的微信读书 ›</navigator><option-picker wx:if="{{!selected && source==='weread' && folders.length>1}}" title="微信读书书单" range="{{folders}}" range-key="name" value="{{folderIndex}}" bindchange="folder"><view class="picker">{{folders[folderIndex].name}}</view></option-picker><button wx:if="{{source==='notebooks' && connection.connected}}" class="secondary" bindtap="syncNotebooks" disabled="{{busy}}">同步笔记目录</button><option-picker wx:if="{{!selected && kind==='movie' && source==='catalog'}}" title="电影分类" range="{{genres}}" value="{{genreIndex}}" bindchange="genre"><view class="picker">{{genres[genreIndex]}}</view></option-picker><input wx:if="{{!selected}}" class="field" value="{{query}}" bindinput="search" placeholder="{{kind==='movie'?'搜索片名、原名或导演':'搜索名称、作者'}}"/>
 <view wx:if="{{selected}}" class="personal-selection"><view class="muted">已选择</view><view class="selected-film-heading"><image wx:if="{{selected.coverUrl}}" class="source-film-cover" src="{{selected.coverUrl}}" mode="aspectFit"/><view class="selected-film-meta"><view class="card-title">{{selected.title}}</view><view class="muted">{{selected.creator}}</view><view wx:if="{{kind==='movie'}}" class="muted">{{selected.year}}{{selected.runtime?'　'+selected.runtime+' 分钟':''}}</view></view></view><block><view class="source-synopsis">{{selected.description||(selected.personalUpload?'个人导入书，暂无公开简介':introError||(selected.introLoaded?'暂无公开简介':'可点开查看完整简介'))}}</view><text wx:if="{{!selected.personalUpload}}" class="source-details" catchtap="details">完整简介 ›</text></block><button class="quiet" bindtap="clearSelection">{{kind==='book'?'换一本':'换一部'}}</button></view><block wx:if="{{!selected}}"><view wx:for="{{rows}}" wx:key="id" class="source-book source-film" data-id="{{item.id}}" bindtap="choose"><image wx:if="{{item.coverUrl}}" class="source-film-cover" src="{{item.coverUrl}}" mode="aspectFit" lazy-load="{{index > 3}}"/><view class="source-film-content"><view class="card-title">{{item.title}}</view><view class="muted">{{item.creator}}</view><block><view class="muted">{{item.year}}{{item.runtime?'　'+item.runtime+' 分钟':''}}</view><view wx:if="{{item.description}}" class="source-synopsis">{{item.description}}</view><view class="source-row-actions"><text wx:if="{{!item.personalUpload}}" class="source-details" data-id="{{item.id}}" catchtap="details">{{item.description?'完整简介':'查看简介'}} ›</text><button class="secondary source-plan-button" data-id="{{item.id}}" catchtap="selectForPlan" disabled="{{busy}}">加入计划</button></view></block></view></view><view wx:if="{{!rows.length && !busy}}" class="empty">{{query?'没有匹配的作品':'这里还没有作品'}}</view></block></block><block wx:if="{{selected || source==='manual'}}"> <view class="switch-row"><text>加入 {{month}} 计划</text><switch checked="{{planned}}" bindchange="planned" color="#252525"/></view><month-picker wx:if="{{planned}}" value="{{month}}" bindchange="month"><view class="picker">选择月份　{{month}}</view></month-picker></block><view wx:if="{{error}}" class="error">{{error}}</view>
</view><view wx:if="{{authorized && (selected || source==='manual')}}" class="dock"><button bindtap="add" disabled="{{busy || (source==='manual'?!title:!selected)}}" loading="{{busy}}">{{planned?'加入计划':'加入想读想看'}}</button></view><view wx:if="{{!authorized && error}}" class="error">{{error}} <text bindtap="load">重试</text></view>
