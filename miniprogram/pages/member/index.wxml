<view class="page"><view class="title">{{member.name}}</view><view wx:for="{{cycles}}" wx:key="id" class="progress-card"><view class="card-title" data-page="cycle" data-id="{{item.id}}" bindtap="open">{{item.title}}</view><view>{{item.memberStatus}} · {{item.completed}} / {{item.total}} 部</view><button wx:if="{{isAdmin&&item.canWrite}}" class="secondary" data-id="{{item.id}}" bindtap="progress">代登记本期进度</button></view><view wx:if="{{!cycles.length}}" class="empty">尚无活动记录</view><button wx:if="{{isAdmin&&member.role!=='admin'}}" class="quiet" bindtap="disable" disabled="{{busy}}">{{member.disabled?'重新启用成员':'停用成员'}}</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
