<view wx:if="{{authorized}}" class="page personal-form personal-key"><view class="title">我的微信读书</view><view class="private-hint">个人书架、进度和笔记仅自己可见。</view>
 <block wx:if="{{connection.connected}}"><view class="section-title">已连接</view><view class="muted">最近同步 {{connection.synced_at}}</view><view wx:if="{{connection.counts}}" class="muted">{{connection.counts.ebooks}} 本电子书　{{connection.counts.audio}} 个有声书条目</view><view class="actions"><button class="secondary" bindtap="sync" loading="{{busy}}" disabled="{{busy}}">同步书架</button><button bindtap="books">选进本月计划</button></view></block>
 <view class="label">{{connection.connected?'更新个人 Key':'连接个人书架'}}</view><input class="field" password value="{{key}}" data-key="key" bindinput="input" maxlength="512" placeholder="粘贴本人微信读书 Key" autocomplete="off"/><button bindtap="connect" disabled="{{busy || !key}}" loading="{{busy}}">{{connection.connected?'校验并更新':'校验并连接'}}</button><button class="quiet" bindtap="obtain">复制官方 Key 获取地址</button>
 <view class="muted">计划在这里管理，不会改动微信读书里的书架。</view><button wx:if="{{connection.connected}}" class="quiet" bindtap="disconnect" disabled="{{busy}}">断开连接</button><view wx:if="{{error}}" class="error">{{error}}</view>
</view><view wx:if="{{!authorized && error}}" class="error">{{error}} <text bindtap="load">重试</text></view>
