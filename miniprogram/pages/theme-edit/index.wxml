<view class="page with-dock"><view class="label">主题名称</view><input class="field" value="{{form.title}}" data-field="form.title" bindinput="input" maxlength="200"/><view class="label">主题简介</view><textarea class="textarea" value="{{form.description}}" data-field="form.description" bindinput="input" maxlength="4000"/><view class="label">讨论角度</view><textarea class="textarea" value="{{form.angles}}" data-field="form.angles" bindinput="input" maxlength="6000"/><view class="label">适用类型</view><option-picker title="主题适用类型" range="{{kinds}}" value="{{kindIndex}}" bindchange="kind"><view class="picker">{{kinds[kindIndex]}}</view></option-picker><view class="label">主题海报</view><option-picker title="主题海报" range="{{posterOptions}}" range-key="title" value="{{posterIndex}}" bindchange="poster"><view class="picker">{{posterOptions[posterIndex].title}}</view></option-picker><view class="label">抽取权重（1—10）</view><input class="field" type="number" value="{{form.weight}}" data-field="form.weight" bindinput="input"/><view class="check"><switch color="#252525" checked="{{form.enabled}}" data-field="form.enabled" bindchange="toggle"/><text>加入候选主题池</text></view><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="dock"><button loading="{{busy}}" disabled="{{busy||!maySave}}" bindtap="save">保存主题</button></view>
