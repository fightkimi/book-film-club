<view wx:if="{{authorized && result}}" class="page personal-form">
 <view class="muted">AI 整理　仅自己可见</view><view class="title">{{result.title}}</view><view wx:if="{{result.stale}}" class="private-hint">原笔记有更新，这份整理保留生成时的内容。</view>
 <view wx:if="{{source}}" class="note-box personal-note"><view class="muted">生成时的{{source.type==='highlight'?'原文划线':'个人想法'}}　{{source.chapter||'未分章'}}</view><view wx:if="{{source.quote}}" class="quote message">{{source.quote}}</view><view class="message">{{source.body}}</view><button class="quiet" bindtap="closeSource">收起原笔记</button></view>
 <block wx:if="{{!editing}}"><view wx:if="{{result.edited}}" class="digest-text">{{result.edited}}</view><view wx:else class="digest-text">{{result.content.summary}}</view>
 <button wx:if="{{result.edited}}" class="quiet" bindtap="original">{{showOriginal?'收起原稿':'查看 AI 原稿与来源'}}</button><block wx:if="{{!result.edited || showOriginal}}"><view wx:if="{{result.edited}}" class="digest-text">{{result.content.summary}}</view><view wx:for="{{result.content.themes}}" wx:key="index"><view class="section-title">{{item.title}}</view><view class="digest-text">{{item.text}}</view><text wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="index" class="digest-source" data-id="{{evidence.note_id}}" bindtap="evidence">「{{evidence.quote}}」· 查看原笔记</text></view>
 <view wx:for="{{result.content.insights}}" wx:key="index"><view class="section-title">{{item.title}}</view><view class="digest-text">{{item.text}}</view><text wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="index" class="digest-source" data-id="{{evidence.note_id}}" bindtap="evidence">「{{evidence.quote}}」· 查看原笔记</text></view>
 <block wx:if="{{result.content.questions.length}}"><view class="section-title">继续想想</view><view wx:for="{{result.content.questions}}" wx:key="index" class="personal-note">{{item}}</view></block></block></block>
 <block wx:else><textarea class="textarea digest-editor" value="{{edited}}" data-key="edited" bindinput="input" maxlength="20000" auto-height cursor-spacing="120"/><button bindtap="save" disabled="{{busy}}">保存我的修改</button></block>
 <view class="personal-links"><text bindtap="edit">{{editing?'返回整理':'修改整理稿'}}</text><text bindtap="share">选一段分享 ›</text></view><view wx:if="{{error}}" class="error">{{error}}</view>
</view><view wx:if="{{!authorized && error}}" class="error">{{error}} <text bindtap="load">重试</text></view>
