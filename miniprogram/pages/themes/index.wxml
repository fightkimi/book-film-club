<view class="page"><view class="eyebrow">THE NEXT CONVERSATION</view><view class="title">下一次，
我们聊什么？</view><view class="actions" wx:if="{{isAdmin}}"><button bindtap="draw">随机抽取主题</button><button class="secondary" bindtap="create">新增主题</button></view><view wx:for="{{themes}}" wx:key="id" class="theme-card" data-page="theme" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.poster}}" class="theme-backdrop" src="{{item.poster.image}}" mode="aspectFill"/><view class="theme-words"><view class="theme-number">{{item.number}} · {{item.enabled?'候选主题':'暂不考虑'}}</view><view class="theme-title">{{item.title}}</view><view class="theme-description">{{item.description}}</view><view class="small">使用 {{item.uses}} 次 →</view><view wx:if="{{item.poster}}" class="small">视觉选片 / {{item.poster.title}}</view></view></view><view class="section-title">抽取历史</view><view wx:for="{{draws}}" wx:key="id" class="card"><view>{{item.theme_title}}</view><view class="muted">{{item.at}}</view></view><view wx:if="{{!draws.length}}" class="muted">尚无抽取记录</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
