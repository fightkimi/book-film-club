<view class="page work-page">
  <block wx:if="{{work}}">
    <view class="work-summary">
      <image wx:if="{{coverUrl}}" class="detail-cover" src="{{coverUrl}}" mode="aspectFit"/>
      <view class="work-heading"><view class="eyebrow">{{work.kindLabel}}<text wx:if="{{work.year}}">　{{work.year}}</text></view><view class="title">{{work.title}}</view><view class="subtitle">{{work.kind==='movie'?'导演　':''}}{{work.creator}}</view><view wx:if="{{work.extra.runtime}}" class="muted">{{work.extra.runtime}} 分钟</view></view>
    </view>
    <view class="section-title">简介</view>
    <view class="prewrap work-synopsis">{{work.description||'简介待补全'}}</view>
    <view class="actions work-main-actions"><button bindtap="writeReview" disabled="{{busy}}">{{work.kind==='book'?'写书评':'写影评'}}</button><button class="secondary" bindtap="personal">加入计划</button></view>
    <view wx:if="{{!bibliographicOnly}}" class="actions"><button class="secondary" bindtap="guide">{{work.kind==='book'?'读前导赏':'观前导赏'}}</button><button class="secondary" bindtap="study">作品深读</button></view>
    <view wx:if="{{work.kind==='movie'}}" class="actions"><button class="secondary" bindtap="shots">逐镜记录</button><button class="secondary" bindtap="ratings">评分与相关影片</button></view>
    <view class="fact" wx:if="{{work.extra.original_title}}"><text class="fact-label">原名</text><text>{{work.extra.original_title}}</text></view><view class="fact"><text class="fact-label">资料来源</text><text>{{sourceName}}</text></view>
    <button class="quiet" bindtap="source">复制资料链接</button>
    <view wx:if="{{isAdmin && !bibliographicOnly}}"><view class="muted">{{work.metadataDetail}}</view><view class="actions"><button class="secondary" bindtap="edit">编辑资料</button><button class="secondary" bindtap="refresh">更新资料</button></view></view>
    <block wx:if="{{cycles.length}}"><view class="section-title">一起读过、看过</view><view wx:for="{{cycles}}" wx:key="id" class="card" data-page="cycle" data-id="{{item.id}}" bindtap="open"><view>{{item.title}}</view><view class="muted">{{item.statusLabel}}</view></view></block>
    <block wx:if="{{!bibliographicOnly}}"><view class="section-title">小组的不同视角</view><view wx:for="{{reviews}}" wx:key="id" class="card"><view>{{item.name}}　{{item.rating}} / 5</view><view class="muted">{{item.workTitle}}</view><button wx:if="{{item.spoiler&&!revealed[item.id]}}" class="quiet" data-id="{{item.id}}" bindtap="reveal">包含剧透，点击展开</button><view wx:else class="prewrap">{{item.body}}</view></view><view wx:if="{{!reviews.length}}" class="muted">还没有本期感想</view></block>
  </block><view wx:if="{{error}}" class="error">{{error}}</view>
</view>
