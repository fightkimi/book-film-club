<view class="page"><view class="eyebrow">{{work.kindLabel}}<text wx:if="{{work.year}}">　{{work.year}}</text></view><view class="title">{{work.title}}</view><view class="subtitle">{{work.creator}}</view><image class="detail-cover" src="{{coverUrl}}" mode="aspectFit"/><option-picker title="我的收藏状态" range="{{shelves}}" value="{{shelfIndex}}" bindchange="shelf" disabled="{{busy}}"><view class="picker">我的片单 / 书单：{{shelves[shelfIndex]}}</view></option-picker><view class="actions"><button bindtap="guide">{{work.kind==='book'?'读前导赏':'观前导赏'}}</button><button class="secondary" bindtap="study">作品深读</button></view><view wx:if="{{work.kind==='movie'}}" class="actions"><button class="secondary" bindtap="shots">逐镜记录</button><button class="secondary" bindtap="ratings">评分与相关影片</button></view><view class="section-title">关于这部作品</view><view class="prewrap">{{work.description||'简介待补全'}}</view><view class="fact" wx:if="{{work.extra.runtime}}"><text class="fact-label">片长</text><text>{{work.extra.runtime}} 分钟</text></view><view class="fact" wx:if="{{work.extra.original_title}}"><text class="fact-label">原名</text><text>{{work.extra.original_title}}</text></view><view class="fact"><text class="fact-label">来源</text><text>{{sourceName}}</text></view><view class="fact"><text class="fact-label">资料</text><text>{{work.metadataDetail}}</text></view><button class="quiet" bindtap="source">复制原始来源链接</button><view wx:if="{{isAdmin}}" class="actions"><button class="secondary" bindtap="edit">编辑资料</button><button class="secondary" bindtap="refresh">重新刮削</button></view><view class="section-title">一起读过、看过</view><view wx:for="{{cycles}}" wx:key="id" class="card" data-page="cycle" data-id="{{item.id}}" bindtap="open">{{item.title}} · {{item.statusLabel}}</view><view class="section-title">小组的不同视角</view><view wx:for="{{reviews}}" wx:key="id" class="card"><view>{{item.name}} · {{item.rating}} / 5</view><button wx:if="{{item.spoiler&&!revealed[item.id]}}" class="quiet" data-id="{{item.id}}" bindtap="reveal">包含剧透，点击展开</button><view wx:else class="prewrap">{{item.body}}</view></view><view wx:if="{{!reviews.length}}" class="muted">参加包含这部作品的活动后，可以提交本期感想。</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
