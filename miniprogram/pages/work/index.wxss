.work-summary{display:flex;align-items:flex-start;gap:20px;}
.detail-cover{flex:none;width:100px;height:150px;background:#f0f0f0;}
.work-heading{min-width:0;flex:1;}
.work-heading .title{font-size:26px;margin:10px 0 12px;line-height:1.4;}
.work-heading .subtitle{font-size:14px;margin:0 0 12px;line-height:1.65;}
.work-heading .eyebrow,.work-heading .muted{font-size:12px;letter-spacing:0;}
.work-synopsis{font-size:15px;line-height:1.85;color:#202020;word-break:normal;overflow-wrap:anywhere;}
.work-page button.work-plan{width:100%;min-height:48px;margin:24px 0 0;}
.work-page .actions{margin:16px 0;}
.work-page .actions button{font-size:14px;}
.work-page .fact{font-size:14px;color:#646464;}
