<view class="page with-dock notebook-page"><view class="title">{{work.title}}</view><view class="subtitle">{{mode==='shots'?'逐镜记录':work.kind==='movie'?'观影笔记':'阅读笔记'}}　仅自己可见</view><view wx:if="{{mode==='shots'}}"><button class="secondary" bindtap="chooseVideo">选择本地片段（不上传）</button><video wx:if="{{videoSrc}}" src="{{videoSrc}}" style="width:100%" controls/><view class="muted">时间从片段起点按秒记录。AI 只读取你填写的文字，不读取视频。</view><view wx:for="{{shots}}" wx:key="index" class="note-box"><view class="section-title">镜头 {{index+1}}</view><view class="row"><view class="grow"><view class="label">开始（秒）</view><input class="field" type="digit" value="{{item.start}}" data-index="{{index}}" data-field="start" bindinput="shotInput"/></view><view class="grow"><view class="label">结束（秒）</view><input class="field" type="digit" value="{{item.end}}" data-index="{{index}}" data-field="end" bindinput="shotInput"/></view></view><view class="label">实际看到 / 听到的证据</view><textarea class="textarea" value="{{item.evidence}}" data-index="{{index}}" data-field="evidence" bindinput="shotInput" maxlength="1000"/><view class="label">景别 / 构图</view><input class="field" value="{{item.composition}}" data-index="{{index}}" data-field="composition" bindinput="shotInput" maxlength="1000"/><view class="label">运镜 / 调度</view><input class="field" value="{{item.movement}}" data-index="{{index}}" data-field="movement" bindinput="shotInput" maxlength="1000"/><view class="label">剪点 / 转场</view><input class="field" value="{{item.cut}}" data-index="{{index}}" data-field="cut" bindinput="shotInput" maxlength="1000"/><view class="label">声音 / 音乐</view><input class="field" value="{{item.sound}}" data-index="{{index}}" data-field="sound" bindinput="shotInput" maxlength="1000"/><button class="quiet" data-index="{{index}}" bindtap="remove">移除此镜头</button></view><button class="secondary" bindtap="addShot">添加镜头</button></view><view class="label">我的想法</view><textarea class="textarea main-reflection" value="{{reflection}}" data-field="reflection" bindinput="input" maxlength="16000" placeholder="哪里让你在意？先写下自己的想法。" cursor-spacing="120"/>
<button class="note-toggle" bindtap="toggleEvidence" aria-expanded="{{evidenceOpen}}"><text>{{work.kind==='movie'?'补充片段与观察':'补充书摘与观察'}}</text><text>{{evidenceOpen?'−':'＋'}}</text></button>
<block wx:if="{{evidenceOpen}}"><textarea class="textarea evidence-notes" value="{{notes}}" data-field="notes" bindinput="input" maxlength="12000" placeholder="记录具体片段、原文或细节" cursor-spacing="120"/><button class="secondary notebook-ai" bindtap="generate" loading="{{busy}}" disabled="{{busy || !services.ai || (!notes && !shots.length)}}">AI 帮我梳理</button></block>
<view wx:if="{{draft}}" class="note-box"><view class="muted">AI 分析草稿</view><view class="prewrap">{{draft.summary}}</view><view wx:for="{{draft.claims}}" wx:key="quote" class="card"><view class="muted">「{{item.quote}}」</view><view>{{item.interpretation}}</view></view><view wx:for="{{draft.questions}}" wx:key="*this" class="muted">{{item}}</view><button class="secondary" bindtap="adopt">放入我的想法</button></view><button wx:if="{{original!==null}}" class="quiet" bindtap="restore">恢复采用前的文字</button><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="dock"><button loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存笔记</button></view>
