<view class="page"><view class="eyebrow">BEFORE WE BEGIN</view><view class="title">{{work.title}}</view><view class="note-box"><view class="muted">{{draft?'AI 导赏草稿':'通用观察卡'}}</view><view class="section-title">不用急着理解一切</view><view>{{draft.intro||'挑一个你感兴趣的问题，带着自己的观察回来交流。'}}</view><view wx:for="{{draft?draft.watchpoints:points}}" wx:key="*this" class="card">{{index+1}}. {{item}}</view><view wx:if="{{draft}}"><view class="section-title">留给讨论的问题</view><view wx:for="{{draft.questions}}" wx:key="*this" class="card">{{item}}</view><view wx:for="{{draft.terms}}" wx:key="name" class="card"><view>{{item.name}}</view><view class="muted">{{item.explanation}}</view></view></view></view><view class="muted">{{draft?'根据作品资料生成，未核验原片或原文。关闭后不保留。':'通用观察提示，不是对这部作品的分析。'}}</view><button class="secondary" bindtap="generate" loading="{{busy}}" disabled="{{busy||!services.ai}}">生成这部作品的导赏</button><view wx:if="{{!services.ai}}" class="notice">AI 尚未配置，通用观察卡仍可使用。</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
