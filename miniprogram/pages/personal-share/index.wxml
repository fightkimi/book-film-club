<view wx:if="{{authorized && item}}" class="page with-dock personal-form"><view class="title">选一段分享</view><view class="muted">{{item.title}}</view>
 <block wx:if="{{snippets.length}}"><view class="label">选取内容</view><option-picker title="选取一段" range="{{snippetNames}}" value="{{snippetIndex}}" bindchange="snippet"><view class="picker">{{snippetNames[snippetIndex]}}</view></option-picker><button class="secondary" bindtap="insert">放入编辑框</button></block>
 <view class="label">标题</view><input class="field" value="{{title}}" data-key="title" bindinput="input" maxlength="60"/>
 <view class="label">分享的文字</view><textarea class="textarea" value="{{body}}" data-key="body" bindinput="input" maxlength="4000" cursor-spacing="120" placeholder="只放入想让别人看到的那一段"/><view class="personal-counter">{{body.length}} / 4000</view>
 <view class="switch-row"><text>涉及情节或结局</text><switch checked="{{spoiler}}" bindchange="spoiler" color="#252525"/></view>
 <view wx:if="{{spoiler}}" class="private-hint">分享后先折叠正文，读者点击再展开</view><view class="label">发到哪里</view><option-picker title="分享范围" range="{{scopes}}" value="{{scopeIndex}}" bindchange="scope"><view class="picker">{{scopes[scopeIndex]}}</view></option-picker>
 <option-picker wx:if="{{!scopeIndex}}" title="城市" range="{{cities}}" value="{{cityIndex}}" bindchange="city"><view class="picker">{{cities[cityIndex]}}</view></option-picker>
 <option-picker wx:elif="{{stores.length}}" title="我的书店圈" range="{{storeNames}}" value="{{storeIndex}}" bindchange="store"><view class="picker">{{storeNames[storeIndex]}}</view></option-picker><view wx:else class="private-hint">还没有加入书店圈</view>
 <view wx:if="{{error}}" class="error">{{error}}</view></view><view wx:if="{{authorized}}" class="dock"><button bindtap="publish" disabled="{{busy || !title || !body || (scopeIndex && !stores.length)}}" loading="{{busy}}">{{scopeIndex?'发布到圈内':'发布到树洞'}}</button></view><view wx:if="{{!authorized && error}}" class="error">{{error}} <text bindtap="load">重试</text></view>
