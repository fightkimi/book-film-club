<view class="page with-dock"><view class="subtitle">总结小组的共识、分歧和下一个问题。成员原始感想分别保留。</view><textarea class="textarea" style="min-height:600rpx" value="{{body}}" data-field="body" bindinput="input" maxlength="20000"/><button class="secondary" bindtap="generate" disabled="{{busy||!services.ai||!isAdmin}}">根据本期共享感想生成草稿</button><view wx:if="{{draft}}" class="note-box"><view class="prewrap">{{draft}}</view><button class="secondary" bindtap="adopt">采用到编辑框</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="dock"><button loading="{{busy}}" disabled="{{busy||!isAdmin}}" bindtap="save">保存回顾</button></view>
