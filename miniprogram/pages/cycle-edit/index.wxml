<view class="page with-dock"><view class="subtitle">先确定主题与参与成员，筹备期间可以继续提名作品。发布后冻结规则。</view><view class="label">活动名称</view><input class="field" value="{{form.title}}" data-field="form.title" bindinput="input" maxlength="200"/><view class="label">主题</view><option-picker title="活动主题" range="{{themes}}" range-key="title" value="{{themeIndex}}" bindchange="theme"><view class="picker">{{themes[themeIndex].title||'请先创建主题'}}</view></option-picker>
<view wx:if="{{cover}}" class="cover-row cover-preview">
  <activity-cover cover="{{cover}}" title="{{form.title}}"/>
  <view class="grow"><view>活动封面</view><view class="muted">{{cover.caption}}</view>
    <view wx:if="{{!cover.image}}" class="muted">选入有封面的作品后会自动配图。</view>
  </view>
</view>
<view class="row"><view class="grow"><view class="label">开始日期</view><picker mode="date" value="{{form.start}}" data-field="form.start" bindchange="input"><view class="picker">{{form.start}}</view></picker></view><view class="grow"><view class="label">截止日期</view><picker mode="date" start="{{form.start}}" value="{{form.end}}" data-field="form.end" bindchange="input"><view class="picker">{{form.end}}</view></picker></view></view><view class="label">活动类型</view><option-picker title="活动类型" range="{{kinds}}" value="{{kindIndex}}" bindchange="kind"><view class="picker">{{kinds[kindIndex]}}</view></option-picker><view class="label">讨论方向</view><textarea class="textarea" value="{{form.direction}}" data-field="form.direction" bindinput="input" maxlength="4000"/><view class="section-title">参与成员</view><checkbox-group bindchange="members"><label wx:for="{{members}}" wx:key="id" class="check"><checkbox color="#252525" value="{{item.id}}" checked="{{item.checked}}"/><text>{{item.name}}</text></label></checkbox-group><view class="section-title">本期作品</view><checkbox-group bindchange="works"><label wx:for="{{works}}" wx:key="id" class="check"><checkbox color="#252525" value="{{item.id}}" checked="{{item.checked}}"/><text>{{item.title}}{{item.metadata_status!=='confirmed'?'（资料待补全）':''}}</text></label></checkbox-group><view class="label">完成要求</view><option-picker title="完成要求" range="{{quantities}}" value="{{quantityIndex}}" bindchange="quantity"><view class="picker">{{quantities[quantityIndex]}}</view></option-picker><view class="check"><switch color="#252525" checked="{{form.rules.review}}" data-field="form.rules.review" bindchange="toggle"/><text>需要提交感想</text></view><view class="check"><switch color="#252525" checked="{{form.rules.discussion}}" data-field="form.rules.discussion" bindchange="toggle"/><text>需要参与讨论</text></view><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="dock"><button loading="{{busy}}" disabled="{{busy||!isAdmin}}" bindtap="save">保存筹备活动</button></view>
