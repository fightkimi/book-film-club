<view class="page with-dock activity-form">
 <view class="form-step">{{step===0?'1　主题与作品':'2　时间与参与者'}}</view>
 <block wx:if="{{step===0}}">
  <view class="title">选主题和作品</view>
  <view class="label">本次主题</view><view class="activity-theme-choice"><button class="secondary" bindtap="generateTheme" loading="{{themeBusyAction==='generate'}}" disabled="{{busy||!services.ai||!canCreateTheme}}">AI 想主题</button><option-picker title="手动选择主题" range="{{themes}}" range-key="title" value="{{themeIndex}}" bindchange="theme" disabled="{{busy}}"><view class="picker {{themeIndex>=0?'selected-theme':''}}">{{themeIndex>=0?themes[themeIndex].title:'手动选择主题'}}</view></option-picker></view><view class="theme-alternatives"><text wx:if="{{canDrawTheme}}" class="new-theme-entry" bindtap="randomTheme">从已有主题抽取</text><text wx:if="{{canCreateTheme}}" class="new-theme-entry" bindtap="newTheme">自己写一个 ›</text></view>
  <view wx:if="{{themeError}}" class="error">{{themeError}}</view><view wx:if="{{!services.ai}}" class="muted">AI 暂不可用，可以先选已有主题</view>
  <view wx:if="{{form.theme_id}}" class="theme-context theme-description">{{themes[themeIndex].description}}</view>
  <view wx:if="{{themeDraft}}" class="theme-suggestion"><view class="muted">AI 新主题</view><view class="suggestion-title">{{themeDraft.title}}</view><view class="theme-description">{{themeDraft.description}}</view><view class="suggestion-angles">{{themeDraft.angles}}</view><view class="actions"><button class="secondary" bindtap="generateTheme" disabled="{{busy}}">再想一个</button><button bindtap="useTheme" loading="{{themeBusyAction==='adopt'}}" disabled="{{busy}}">用这个主题</button></view></view>

  <view class="label">活动类型</view><option-picker disabled="{{busy}}" title="活动类型" range="{{kinds}}" value="{{kindIndex}}" bindchange="kind"><view class="picker">{{kinds[kindIndex]}}</view></option-picker>
  <view class="section-title work-heading"><text>{{form.kind==='movie'?'本期电影':form.kind==='book'?'本期书籍':'本期作品'}}</text><text class="muted">已选 {{form.work_ids.length}} {{form.kind==='book'?'本':'部'}}</text></view>
  <button class="secondary works-ai" bindtap="recommendWorks" loading="{{picksBusy}}" disabled="{{busy||!services.ai}}">{{picksLoaded?'AI 换一批':form.kind==='movie'?'AI 帮我选片':form.kind==='book'?'AI 帮我选书':'AI 先选一批'}}</button>
  <view wx:if="{{picksError}}" class="error">{{picksError}}</view>
  <view wx:if="{{picksLoaded && !recommendations.length}}" class="muted work-notice">暂时没有合适的推荐，可以换一批或手动选择。</view>
  <view wx:if="{{recommendations.length}}" class="recommended-works"><checkbox-group bindchange="selectRecommended"><label wx:for="{{recommendations}}" wx:key="id" class="check work-choice"><checkbox color="#202020" disabled="{{busy}}" value="{{item.id}}" checked="{{item.checked}}"/><view class="work-info"><text class="work-title">{{item.title}}</text><text class="muted work-byline">{{item.kind==='movie'?'电影':'书籍'}}{{item.creator?'　'+item.creator:''}}</text><text class="pick-reason">{{item.reason}}</text><text wx:if="{{item.caveat}}" class="muted pick-caveat">{{item.caveat}}</text></view></label></checkbox-group><button class="secondary works-ai" bindtap="selectAllRecommended" disabled="{{busy||allPicksSelected}}">{{allPicksSelected?'已选入':'全部选入本次活动'}}</button><view class="label">自己再挑选</view></view>
  <input class="field" placeholder="{{form.kind==='movie'?'搜索片名、译名或导演':form.kind==='book'?'搜索书名或作者':'搜索书名、片名、作者或导演'}}" value="{{workQuery}}" bindinput="searchWorks"/>
  <view wx:if="{{workNotice}}" class="muted work-notice">{{workNotice}}</view>
  <button wx:if="{{workError && form.kind!=='book'}}" class="quiet" bindtap="retryMovies" disabled="{{busy}}">{{workError}}</button>
  <checkbox-group bindchange="works"><label wx:for="{{works}}" wx:key="id" class="check work-choice"><checkbox disabled="{{busy}}" color="#202020" value="{{item.id}}" checked="{{item.checked}}"/><view class="work-info"><text class="work-title">{{item.title}}</text><text class="muted work-byline">{{item.kindLabel}}{{item.creator?'　'+item.creator:''}}{{!item.externalMovie && item.metadata_status!=='confirmed'?'　资料待补全':''}}</text></view></label></checkbox-group>
  <view wx:if="{{!works.length && !busy}}" class="empty">{{workQuery?'没有找到匹配的作品':form.kind==='movie'?'暂时没有可选电影':form.kind==='book'?'暂时没有可选书籍':'暂时没有可选作品'}}</view>
  <button wx:if="{{works.length < workCount}}" class="quiet" bindtap="moreWorks">查看更多作品</button>
 </block>
 <block wx:else>
  <view class="title">安排这次相聚</view>
  <view class="theme-context">{{form.theme_id?themes[themeIndex].title:'未选主题'}}　{{form.work_ids.length}} 部作品</view>
  <view class="label">活动名称</view><input class="field" value="{{form.title}}" data-field="form.title" bindinput="input" maxlength="200"/>
  <view class="activity-dates"><view><view class="label">开始日期</view><picker mode="date" value="{{form.start}}" data-field="form.start" bindchange="input"><view class="picker">{{form.start}}</view></picker></view><view><view class="label">截止日期</view><picker mode="date" start="{{form.start}}" value="{{form.end}}" data-field="form.end" bindchange="input"><view class="picker">{{form.end}}</view></picker></view></view>
  <view class="label">讨论方向</view><textarea class="textarea" value="{{form.direction}}" data-field="form.direction" bindinput="input" maxlength="4000" placeholder="这次最想听大家聊什么？"/>
  <button class="form-expand" bindtap="toggleMembers" aria-expanded="{{membersOpen}}"><text>参与成员　{{form.member_ids.length}} 人</text><text>{{membersOpen?'−':'＋'}}</text></button>
  <checkbox-group wx:if="{{membersOpen}}" bindchange="members"><label wx:for="{{members}}" wx:key="id" class="check"><checkbox disabled="{{busy}}" color="#202020" value="{{item.id}}" checked="{{item.checked}}"/><text>{{item.name}}</text></label></checkbox-group>
  <button class="form-expand" bindtap="toggleRules" aria-expanded="{{rulesOpen}}"><text>完成方式</text><text>{{rulesOpen?'−':'＋'}}</text></button>
  <view class="muted">{{quantityIndex===0?'完成全部作品':'任选一部完成'}}{{form.rules.review?'，留下感想':''}}{{form.rules.discussion?'，参与讨论':''}}</view>
  <block wx:if="{{rulesOpen}}"><option-picker title="完成要求" range="{{quantities}}" value="{{quantityIndex}}" bindchange="quantity"><view class="picker">{{quantities[quantityIndex]}}</view></option-picker><view class="check"><switch color="#202020" checked="{{form.rules.review}}" data-field="form.rules.review" bindchange="toggle"/><text>需要提交感想</text></view><view class="check"><switch color="#202020" checked="{{form.rules.discussion}}" data-field="form.rules.discussion" bindchange="toggle"/><text>需要参与讨论</text></view></block>
 </block>
 <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
<view class="dock"><button wx:if="{{step===1}}" class="secondary" bindtap="previousStep" disabled="{{busy}}">上一步</button><button wx:if="{{step===0}}" bindtap="nextStep" loading="{{busy && !themeBusyAction}}" disabled="{{busy||!mayEdit}}">下一步</button><button wx:else loading="{{busy}}" disabled="{{busy||!mayEdit}}" bindtap="save">保存筹备活动</button></view>
