<view class="page with-dock"><view class="subtitle">{{targetName}} · 本期任务独立于个人收藏。</view><option-picker title="本期作品" range="{{cycle.works}}" range-key="title" value="{{workIndex}}" bindchange="work"><view class="picker">{{cycle.works[workIndex].title}}</view></option-picker><view class="title">{{progress}}%</view><slider value="{{progress}}" min="0" max="100" step="5" activeColor="#252525" bindchange="percent" show-value/><view class="label">准确进度（0—100）</view><input class="field" type="number" value="{{progress}}" data-field="progress" bindinput="input"/><view class="label">个人笔记（本人和管理员可见）</view><textarea class="textarea" value="{{note}}" data-field="note" bindinput="input" maxlength="10000"/><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="dock"><button loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存进度</button></view>
