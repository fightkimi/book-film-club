<view class="page"><view wx:if="{{!preview}}"><view class="subtitle">先核对作品和版本，再将资料与图片加入书影库。</view><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="kind" disabled="{{busy}}"><view class="picker">{{kinds[kindIndex]}}</view></picker><picker wx:if="{{kindIndex===0}}" range="{{providerNames}}" value="{{providerIndex}}" bindchange="provider" disabled="{{busy}}"><view class="picker">{{providerNames[providerIndex]}}</view></picker><view class="label">书名、ISBN 或中文电影名称</view><input class="field" data-field="queryText" value="{{queryText}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="160"/><view class="actions"><button loading="{{busy}}" disabled="{{busy}}" bindtap="search">搜索</button></view><view wx:if="{{results&&results.length===0}}" class="empty">没有找到匹配作品，试试原名、ISBN 或其他来源。</view><view wx:for="{{results}}" wx:key="source_id" class="card row" data-index="{{index}}" bindtap="detail"><image src="{{item.coverUrl}}" class="list-cover" mode="aspectFit"/><view class="grow"><view class="card-title">{{item.title}}</view><view class="muted">{{item.creator}} {{item.year}}</view><text class="small">查看资料与图片 →</text></view></view><button class="quiet" bindtap="manual">手工补充资料</button></view><view wx:else><button class="quiet" bindtap="back">返回候选</button><image class="cover" src="{{previewCover}}" mode="aspectFit"/><view class="title">{{preview.item.title}}</view><view class="subtitle">{{preview.item.creator}} · {{preview.item.year}}</view><view class="prewrap">{{preview.item.description||'暂无简介'}}</view><view class="muted">来源：{{preview.item.provider}}</view><view class="actions"><button loading="{{busy}}" disabled="{{busy}}" bindtap="save">确认匹配并导入</button><button class="secondary" bindtap="manual">补充 / 合并</button></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
