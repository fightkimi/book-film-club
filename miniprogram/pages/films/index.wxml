<view class="page"><view class="title">{{work?work.title:'TMDB 高分电影榜'}}</view><view wx:if="{{work}}"><view class="subtitle">不同评分尺度分别显示，不合成总分。</view><view wx:for="{{result.ratings}}" wx:key="source" class="progress-card"><view>{{item.source}}</view><view class="title">{{item.value}}</view><view class="muted">{{item.via?'经 '+item.via+' 获取':'直接来自 TMDB'}}</view></view><view wx:for="{{result.warnings}}" wx:key="*this" class="notice">{{item}}</view><view class="section-title">相关影片</view></view><view class="book-grid"><view wx:for="{{items}}" wx:key="source_id" data-title="{{item.title}}" bindtap="search"><image class="cover" src="{{item.image}}" mode="aspectFit"/><view class="book-title">{{item.rank?item.rank+'. ':''}}{{item.title}}</view><view class="muted">{{item.year}} · 点击核对资料</view></view></view><view wx:if="{{result&&!items.length}}" class="empty">暂时没有影片结果。</view><view wx:if="{{!work&&result}}" class="actions"><button class="secondary" data-step="-1" bindtap="next" disabled="{{busy||page===1}}">上一页</button><button class="secondary" data-step="1" bindtap="next" disabled="{{busy||page>=10||!items.length}}">下一页</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
