.entry-page {
  box-sizing: border-box;
  min-height: 100vh;
  display: grid;
  grid-template-rows: 1fr auto 1fr;
  padding: 30rpx 44rpx calc(30rpx + env(safe-area-inset-bottom));
}
.entry-page .club-masthead { align-self: start; padding: 16rpx 0; border: 0; }
.entry-page .club-opening {
  text-align: center;
  padding: 30rpx 0;
  font-size: 52rpx;
  line-height: 1.5;
}
.entry-actions { align-self: end; width: 100%; }
.entry-submit { width: 100%; min-height: 96rpx; background: #252525; }
.entry-hint, .entry-error { margin: 0 0 20rpx; font-size: 25rpx; text-align: center; }
.entry-hint { color: #656565; }
.entry-error { color: #a3322c; }
.existing-login { width: 100%; min-height: 44px; margin-top: 8rpx; font-size: 28rpx; }
