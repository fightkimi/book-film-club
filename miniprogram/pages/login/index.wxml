<view class="page entry-page">
  <view class="entry-hero">
    <view class="entry-scene">
      <image class="entry-still" src="/assets/film/hirayama-reading-room.jpg" mode="aspectFill" aria-hidden="true"/>
    </view>
    <view class="club-opening"><text>合上书，散了场</text><text>我们接着聊</text></view>
  </view>
  <view class="entry-actions">
    <view wx:if="{{error}}" class="entry-error">{{error}}</view>
    <view wx:elif="{{invited}}" class="entry-hint">首次登录将绑定邀请对应的小组成员。</view>
    <button class="entry-submit" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">
      {{busy ? '正在登录…' : (invited ? '接受邀请并登录' : '微信登录')}}
    </button>
    <button wx:if="{{invited}}" class="quiet existing-login" data-identity="existing" disabled="{{busy}}" bindtap="submit">用我已绑定的身份登录</button>
  </view>
</view>
