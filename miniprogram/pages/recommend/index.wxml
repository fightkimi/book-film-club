<view class="page {{!cycle && selectedIds.length?'with-dock':''}}"><view class="eyebrow">为这次活动挑选作品</view><view class="title">{{theme.title}}</view><option-picker title="作品类型" range="{{kinds}}" value="{{kindIndex}}" data-field="kindIndex" bindchange="change"><view class="picker">{{kinds[kindIndex]}}</view></option-picker><option-picker wx:if="{{kindIndex!==1}}" title="片长" range="{{durations}}" value="{{minutesIndex}}" data-field="minutesIndex" bindchange="change"><view class="picker">{{durations[minutesIndex]}}</view></option-picker><view class="label">这次想看什么</view><input class="field" value="{{mood}}" data-field="mood" bindinput="change" maxlength="300" placeholder="轻松一些，希望看完有话聊"/><view class="check"><switch color="#252525" checked="{{exclude}}" data-field="exclude" bindchange="change"/><text>排除我已读完 / 看完的作品</text></view><view wx:if="{{minutesIndex>0 && kindIndex!==1}}" class="muted">片长未知的电影不在结果中</view><view class="actions"><button bindtap="search" loading="{{busy}}" disabled="{{busy}}">查找作品</button><button class="secondary" bindtap="generate" disabled="{{busy||!services.ai||!rows||!rows.length}}">AI 帮我挑选</button></view><view wx:if="{{rows}}" class="muted">{{aiResult?'AI 推荐草稿，供你判断。':'待选作品'}}</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="row" data-page="work" data-id="{{item.id}}" bindtap="open"><image class="list-cover" src="{{item.coverUrl}}" mode="aspectFit"/><view class="grow"><view class="card-title">{{item.title}}</view><view class="muted">{{item.creator}}</view></view></view><view>{{item.reason}}</view><view class="muted">{{item.caveat}}</view><button wx:if="{{cycle}}" class="secondary" data-id="{{item.id}}" bindtap="nominate" disabled="{{busy}}">提名到本期</button><button wx:elif="{{canStartActivity}}" class="secondary" data-id="{{item.id}}" bindtap="select">{{item.selected?'已选入本次活动':'选入本次活动'}}</button></view><view wx:if="{{rows&&rows.length===0}}" class="empty">没有合适结果，试着放宽筛选或补充片库。</view><button class="quiet" bindtap="add">搜索并补充作品</button><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view>

<view wx:if="{{!cycle && canStartActivity && selectedIds.length}}" class="dock"><button bindtap="createActivity">带上 {{selectedIds.length}} 部作品，发起活动</button></view>
