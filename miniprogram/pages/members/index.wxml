<view class="page"><view class="title">一起读书、看电影的人</view><button wx:if="{{isAdmin}}" class="secondary" bindtap="add">{{adding?'收起':'添加成员'}}</button><view wx:if="{{adding}}" class="note-box"><view class="label">成员名字</view><input class="field" value="{{name}}" data-field="name" bindinput="input"/><view class="label">登录账号</view><input class="field" value="{{username}}" data-field="username" bindinput="input"/><view class="label">初始密码（至少 10 位）</view><input class="field" password="{{true}}" value="{{credential}}" data-field="credential" bindinput="input"/><button bindtap="save" disabled="{{busy}}">创建成员</button></view><view wx:for="{{members}}" wx:key="id" class="card between" data-id="{{item.id}}" bindtap="view"><view><view class="card-title">{{item.name}}</view><view class="muted">{{item.role==='admin'?'管理员':'成员'}} · {{item.cycles}} 期参与{{item.disabled?' · 已停用':''}}</view></view><text>→</text></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
