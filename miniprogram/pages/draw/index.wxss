.draw-stage{margin:50rpx 0;min-height:420rpx;background:#263238;color:#fff;padding:28rpx;display:flex;align-items:center;justify-content:center;overflow:hidden}.shelf{display:flex;align-items:flex-end;border-bottom:6rpx solid #94a1a4;width:100%;height:300rpx;gap:10rpx}.spine{writing-mode:vertical-rl;flex:1;background:#d9ddda;color:#223039;padding:18rpx 12rpx;height:240rpx;font-family:serif}.spine:nth-child(2n){height:270rpx;background:#aebcbd}.drawing .spine{animation:shuffle 1s ease-in-out infinite}.drawing .spine:nth-child(2n){animation-delay:.3s}.cinema{border:12rpx solid #171c1e;background:#e8ece9;color:#222}.cinema .spine{background:#293a42;color:white}.reveal{text-align:center;animation:fade .5s ease-out}@keyframes shuffle{0%,100%{transform:translateY(0)}50%{transform:translateY(-28rpx)}}@keyframes fade{from{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}
