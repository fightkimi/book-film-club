<view class="page"><view class="eyebrow">A NEW BEGINNING</view><view class="title">让下一次相遇，
从一个主题开始。</view><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="kind" disabled="{{phase==='drawing'}}"><view class="picker">{{kinds[kindIndex]}}</view></picker><picker range="{{modes}}" value="{{modeIndex}}" bindchange="mode" disabled="{{phase==='drawing'}}"><view class="picker">{{modes[modeIndex]}}</view></picker><view class="draw-stage {{phase}} {{kindIndex===1?'cinema':'bookshelf'}}"><view wx:if="{{phase!=='revealed'}}" class="shelf"><view wx:for="{{candidates}}" wx:key="id" class="spine">{{item.title}}</view></view><view wx:if="{{phase==='revealed'}}" class="reveal"><view class="small">本次抽取</view><view class="theme-title">{{result.theme_title}}</view></view></view><button wx:if="{{phase!=='drawing'}}" loading="{{busy}}" disabled="{{busy||!isAdmin}}" bindtap="draw">{{phase==='revealed'?'再抽一次':'开始抽取'}}</button><button wx:if="{{phase==='drawing'}}" class="quiet" bindtap="skip">直接查看结果</button><view wx:if="{{phase==='revealed'}}" class="actions"><button class="secondary" bindtap="openResult">查看主题</button><button bindtap="create">发起活动</button></view><view class="muted">每次抽取都会保留记录，退出页面也不会改变结果。</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
