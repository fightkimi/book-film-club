<view class="page"><view class="eyebrow">THE COLLECTION</view><view class="title">我们的书单与片库</view><input class="field" placeholder="搜索作品、作者、导演、译名" value="{{query}}" bindinput="search"/><view class="row"><picker class="grow" range="{{kinds}}" value="{{kindIndex}}" bindchange="kind"><view class="picker">{{kinds[kindIndex]}}</view></picker><picker class="grow" range="{{shelves}}" value="{{shelfIndex}}" bindchange="shelf"><view class="picker">{{shelves[shelfIndex]}}</view></picker></view><view class="actions"><button class="secondary" bindtap="add">搜索资料并加入作品</button></view><view class="muted">{{works.length}} 部作品</view><view class="book-grid"><view wx:for="{{works}}" wx:key="id" data-page="work" data-id="{{item.id}}" bindtap="open"><image class="cover" src="{{item.image}}" mode="aspectFit" lazy-load/><view class="book-title">{{item.title}}</view><view class="book-creator">{{item.creator}}</view><view class="muted">{{item.kindLabel}} · {{item.year}}</view><view wx:if="{{!item.complete}}" class="tag">资料待补全</view></view></view><view wx:if="{{!works.length}}" class="empty">没有符合条件的作品，试着调整筛选。</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
