<view wx:if="{{authorized}}" class="page tab-page personal-library">
  <view class="personal-head"><view class="title">我的书影</view><button wx:if="{{items.length}}" class="secondary" bindtap="add" disabled="{{busy}}">＋ 添加</button></view>
  <view class="personal-tabs"><button wx:for="{{tabs}}" wx:key="id" class="{{view===item.id?'active':''}}" data-id="{{item.id}}" bindtap="tab" disabled="{{busy}}">{{item.label}}</button></view>
  <view class="library-toolbar">
    <month-picker wx:if="{{view==='month'}}" class="library-month" value="{{month}}" bindchange="month" aria-label="选择计划月份"><view class="library-month-label">{{monthLabel}}<text class="picker-chevron">⌄</text></view></month-picker>
    <view wx:else class="library-view-label">{{view==='wish'?'待读待看':'完成记录'}}</view>
    <view class="library-types"><button wx:for="{{types}}" wx:key="id" class="{{kind===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="kind" disabled="{{busy}}">{{item.label}}</button></view>
  </view>
  <view wx:if="{{view==='month' && (completed.book || completed.movie)}}" class="library-summary">本月读完 {{completed.book||0}} 本，看过 {{completed.movie||0}} 部</view>
  <view wx:for="{{items}}" wx:key="id" class="personal-row" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.image}}" class="personal-cover" src="{{item.thumbnail}}" mode="aspectFit" lazy-load="{{index > 3}}"/><view class="personal-row-main"><view class="personal-status">{{item.kindLabel}}　{{item.statusLabel}}</view><view class="card-title">{{item.title}}</view><view class="muted">{{item.creator}}</view><block wx:if="{{item.kind==='book' && item.status==='reading'}}"><progress class="personal-progress" percent="{{item.progress}}" stroke-width="2" activeColor="#202020"/><view class="muted">读到 {{item.progress}}%</view></block><view wx:if="{{view==='done'}}" class="muted">{{item.last_finished||'完成日期未记录'}}{{item.rating?'　'+item.rating+' / 5':''}}</view><view wx:if="{{item.reflection_excerpt}}" class="reflection-excerpt">{{item.reflection_excerpt}}{{item.reflection_long?'…':''}}</view><view class="personal-row-actions"><text wx:if="{{item.reflection_excerpt}}" class="review-read-link">{{item.reflection_long?'阅读全文':'查看感想'}} ›</text><button class="quiet quick-reflection" data-id="{{item.id}}" catchtap="write">{{item.reflection_excerpt?'继续写':'记一句'}}</button></view></view><text class="row-arrow">›</text></view>
  <view wx:if="{{!items.length}}" class="personal-empty"><view class="empty-title">{{busy?'正在读取…':view==='month'?'这个月还没有计划':view==='wish'?'还没有想读想看的作品':'还没有完成记录'}}</view><button bindtap="add" disabled="{{busy}}">添加书或电影</button></view>
  <navigator class="library-catalog" url="/pages/catalog/index"><text>逛逛书影资料库</text><text aria-hidden="true">›</text></navigator>
  <view wx:if="{{error}}" class="error">{{error}} <text bindtap="load">重试</text></view>
</view><view wx:if="{{!authorized && error}}" class="error">{{error}} <text bindtap="load">重试</text></view>

<share-card id="share-card"/>
