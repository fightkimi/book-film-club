<view class="page"><view class="eyebrow">MY READING &amp; VIEWING</view><view class="title">{{user.name}}</view><view class="subtitle">{{group}}</view><mp-cells><mp-cell value="书影工具与个人档案" footer="{{journalCount}} 条档案" link bindtap="toolkit"/><mp-cell value="小组成员" link bindtap="members"/><mp-cell value="账号设置" link bindtap="settings"/></mp-cells><view class="section-title">每一期的脚印</view><view wx:for="{{reports}}" wx:key="cycle_id" class="progress-card" data-page="cycle" data-id="{{item.cycle_id}}" bindtap="open"><view>{{item.cycleTitle}}</view><view class="muted">{{item.statusLabel}} · 完成 {{item.completed}} / {{item.total}} 部</view></view><view wx:if="{{!reports.length}}" class="empty">参加一期活动，从共同的话题开始。</view><button class="quiet" bindtap="logout">退出登录</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
