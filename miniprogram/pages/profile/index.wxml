<view class="page tab-page profile">
  <block wx:if="{{user}}">
    <view class="identity">
      <view class="member-name">{{user.name}}</view>
      <view class="affiliation"><text class="group-label">所在小组</text><text>{{group}}</text></view>
    </view>

    <view class="section-head"><text class="heading">我的活动</text><text wx:if="{{reports.length}}" class="count">{{reports.length}} 期</text></view>
    <view wx:if="{{reports.length}}" class="periods">
      <navigator wx:for="{{reports}}" wx:key="cycle_id" url="/pages/cycle/index?id={{item.cycle_id}}" class="period" hover-class="row-pressed">
        <view class="period-top"><text class="period-name">{{item.cycleTitle}}</text><text class="period-state">{{item.statusLabel}}</text></view>
        <view class="period-progress">{{item.startLabel}}{{item.total ? '　已完成 ' + item.completed + ' / ' + item.total + ' 部' : ''}}</view>
      </navigator>
    </view>
    <view wx:else class="empty-period">
      <text>还没有参与的活动</text>
      <navigator class="browse" url="/pages/activities/index" open-type="switchTab" hover-class="row-pressed">去看活动 <text aria-hidden="true">→</text></navigator>
    </view>

    <view class="section-head"><text class="heading">个人记录</text></view>
    <mp-cells>
      <mp-cell value="书影档案" footer="{{journalCount ? journalCount + ' 条记录' : ''}}" link bindtap="archive"/>
      <mp-cell value="书影工具" link bindtap="toolkit"/>
    </mp-cells>

    <view class="section-head"><text class="heading">小组与账号</text></view>
    <mp-cells>
      <mp-cell value="小组成员" link bindtap="members"/>
      <mp-cell value="账号设置" link bindtap="settings"/>
    </mp-cells>
  </block>
  <view wx:elif="{{busy}}" class="muted">正在读取个人记录…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
