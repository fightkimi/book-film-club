<view class="page tab-page profile">
  <block wx:if="{{user}}">
    <view class="identity">
      <view class="member-name">{{user.name}}</view>
      <view class="affiliation"><text class="group-label">所在小组</text><text>{{group}}</text></view>
    </view>

    <view class="section-head"><text class="heading">我参加的</text><navigator class="count" url="/pages/my-activities/index">查看全部 ›</navigator></view>
    <view wx:if="{{attending.length}}" class="periods">
      <navigator wx:for="{{attendingPreview}}" wx:key="key" url="{{item.url}}" class="period" hover-class="row-pressed">
        <view class="period-top"><text class="period-name">{{item.title}}</text><text class="period-state">{{item.status}}</text></view>
        <view class="period-progress">{{item.type}} · {{item.date}}</view>
      </navigator>
    </view>
    <view wx:elif="{{!busy && !attendanceError}}" class="empty-period"><text>还没有参加的活动</text><navigator class="browse" url="/pages/activities/index" open-type="switchTab">去看看 →</navigator></view>
    <view wx:if="{{attendanceError}}" class="attendance-error" bindtap="onPullDownRefresh">{{attendanceError}}</view>

    <view class="section-head"><text class="heading">个人记录</text></view>
    <mp-cells>
      <mp-cell value="我的书影" link bindtap="personalBooks"/>
      <mp-cell value="微信读书连接" link bindtap="personalConnect"/>
      <mp-cell value="关注的书店" link bindtap="following"/>
    </mp-cells>

    <view class="section-head"><text class="heading">小组与账号</text></view>
    <mp-cells>
      <mp-cell value="{{isAdmin ? '小组成员与邀请' : '小组成员'}}" link bindtap="members"/>
      <mp-cell value="账号设置" link bindtap="settings"/>
    </mp-cells>
  </block>
  <view wx:elif="{{busy}}" class="muted">正在读取个人记录…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>

<share-card id="share-card"/>
