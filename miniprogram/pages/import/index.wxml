<view class="page"><view class="title">导入 {{providerName}}</view><view class="subtitle">先预览、再确认。仅保存到个人档案，不公开为小组评价，也不完成本期任务。</view><view wx:if="{{done}}" class="note-box"><view>新增 {{done.added}} 条，更新 {{done.updated}} 条，跳过 {{done.skipped}} 条。</view><button bindtap="finish">查看我的档案</button></view><view wx:elif="{{!preview}}"><picker wx:if="{{provider==='trakt'}}" range="{{modes}}" value="{{modeIndex}}" data-field="modeIndex" bindchange="pick"><view class="picker">{{modes[modeIndex]}}</view></picker><view wx:if="{{provider==='trakt'&&modeIndex===1}}"><view class="label">我的 Trakt 用户名</view><input class="field" value="{{username}}" data-field="username" bindinput="input" maxlength="80"/><picker range="{{collections}}" value="{{collectionIndex}}" data-field="collectionIndex" bindchange="pick"><view class="picker">{{collections[collectionIndex]}}</view></picker><view class="label">页码（每页 50 条）</view><input class="field" type="number" value="{{page}}" data-field="page" bindinput="input"/><view class="muted">私人账号请使用导出文件。</view></view><view wx:else><button class="secondary" bindtap="choose">从微信会话选择 {{provider==='trakt'?'JSON':'CSV'}} 文件</button><view class="label">或粘贴文件内容</view><textarea class="textarea" value="{{content}}" data-field="content" bindinput="input" maxlength="100000"/><view class="muted">每批最多 200 条、100 KB。豆瓣支持 Douban Sync 字段；Trakt 请先解压电影 JSON 文件。</view><picker wx:if="{{provider!=='douban'}}" range="{{statuses}}" value="{{statusIndex}}" data-field="statusIndex" bindchange="pick"><view class="picker">{{statuses[statusIndex]}}</view></picker></view><view class="actions"><button loading="{{busy}}" disabled="{{busy}}" bindtap="loadPreview">预览记录</button></view></view><view wx:else><view>{{rows.length}} 条有效记录，请核对作品关联。</view><view wx:for="{{preview.errors}}" wx:key="line" class="notice">第 {{item.line}} 条：{{item.message}}</view><view wx:for="{{rows}}" wx:key="source_key" class="card"><view class="check"><switch color="#252525" checked="{{item.selected}}" data-index="{{index}}" bindchange="selection"/><text>{{item.title}}</text></view><view class="muted">{{item.date||'日期未提供'}} · {{item.rating===null?'未评分':item.rating+' / 5'}} · {{item.statusLabel}}</view><picker range="{{item.choices}}" range-key="title" value="{{item.choiceIndex}}" data-index="{{index}}" bindchange="match"><view class="picker">{{item.choices[item.choiceIndex].title}}</view></picker></view><view class="check"><switch color="#252525" checked="{{overwrite}}" data-field="overwrite" bindchange="toggle"/><text>覆盖已导入记录与关联</text></view><view class="check"><switch color="#252525" checked="{{sync}}" data-field="sync" bindchange="toggle"/><text>同时更新我的片单 / 书单状态</text></view><view class="actions"><button loading="{{busy}}" disabled="{{busy||!rows.length}}" bindtap="save">确认导入</button><button class="secondary" bindtap="back" disabled="{{busy}}">返回修改</button></view></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
