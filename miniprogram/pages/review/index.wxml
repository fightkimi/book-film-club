<view class="page with-dock"><picker range="{{cycle.works}}" range-key="title" value="{{workIndex}}" bindchange="work"><view class="picker">{{cycle.works[workIndex].title}}</view></picker><view class="label">评分</view><picker range="{{ratings}}" value="{{ratingIndex}}" bindchange="rating"><view class="picker">{{ratings[ratingIndex]}}</view></picker><view class="label">我的感想</view><textarea class="textarea" style="min-height:360rpx" value="{{body}}" data-field="body" bindinput="input" maxlength="20000" placeholder="哪个细节改变了你的看法？它和本期主题有什么联系？"/><view class="check"><switch checked="{{spoiler}}" data-field="spoiler" bindchange="toggle" color="#252525"/><text>包含剧透，默认折叠</text></view><view class="section-title">保留你的声音</view><view class="muted">只整理你写下的内容；确认采用后再保存。</view><button class="secondary" disabled="{{busy||!services.ai||!body}}" bindtap="assist">整理我的感想</button><view wx:if="{{!services.ai}}" class="notice">AI 尚未配置，可以直接保存感想。</view><view wx:if="{{draft}}" class="note-box"><view wx:for="{{draft.suggestions}}" wx:key="*this">· {{item}}</view><view class="section-title">可以再想一想</view><view wx:for="{{draft.questions}}" wx:key="*this">· {{item}}</view><view class="section-title">整理稿</view><view class="prewrap">{{draft.polished}}</view><button class="secondary" bindtap="adopt">采用到编辑框</button></view><button wx:if="{{original!==null}}" class="quiet" bindtap="restore">恢复采用前原稿</button><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="dock"><button loading="{{busy}}" disabled="{{busy}}" bindtap="save">保存本期感想</button></view>
