:host{display:block;min-width:0;}
.month-sheet{box-sizing:border-box;width:100%;padding:0 4px 24px;color:#202020;}
.month-year{display:grid;grid-template-columns:44px minmax(0,1fr) 44px;align-items:center;gap:12px;margin:0 0 20px;padding:0 0 14px;border-bottom:0.5px solid #d9d9d9;}
.year-label{text-align:center;font-size:20px;font-weight:500;line-height:1.4;white-space:nowrap;}
.year-step{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:44px;height:44px;font-size:26px;line-height:1;color:#646464;}
.year-disabled{color:#cecece;}
.month-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:4px;row-gap:12px;}
.month-option{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;min-height:48px;}
.month-name{display:flex;align-items:center;justify-content:center;min-width:54px;height:40px;box-sizing:border-box;font-size:17px;font-weight:400;line-height:1.3;white-space:nowrap;}
.month-chosen{color:#fcfcfc;background:#202020;border-radius:3px;font-weight:500;}
.month-pressed{background:#f9f9f9;}
