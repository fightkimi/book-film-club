  <view class="typeset"><text class="imprint">un eco</text><text class="name">{{title || '本期活动'}}</text></view>
  <image wx:if="{{cover.image && failedImage !== cover.image}}" src="{{cover.image}}" data-src="{{cover.image}}" mode="aspectFit" class="art" binderror="imageError"/>
</view>
