page{background:#fff;color:#202124;font-family:-apple-system,"Noto Sans CJK SC","PingFang SC",sans-serif;font-size:26rpx;line-height:1.72;--weui-BRAND:#252525;--weui-BRAND-100:#252525;--weui-BG-0:#fff;--weui-FG-0:#202124}
.page{padding:40rpx 36rpx 64rpx}.with-dock{padding-bottom:190rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#666}.title{font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:50rpx;font-weight:500;line-height:1.3;margin:20rpx 0 24rpx}.subtitle{color:#656565;font-size:26rpx;margin:12rpx 0 36rpx}.section-title{font-family:"Songti SC",serif;font-size:36rpx;margin:42rpx 0 22rpx}.muted{font-size:24rpx;color:#777}.small{font-size:23rpx}.prewrap{white-space:pre-wrap;word-break:break-all}.error{background:#fff2f0;color:#9f2a23;padding:24rpx;margin:24rpx 0}.notice{background:#f3f4f4;padding:24rpx;margin:24rpx 0;color:#42535c}.empty{padding:70rpx 20rpx;text-align:center;color:#777}.divider{height:1rpx;background:#ddd;margin:32rpx 0}.row{display:flex;align-items:center;flex-wrap:wrap;gap:20rpx}.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grow{flex:1;min-width:0}.tag{font-size:22rpx;background:#f1f1f1;padding:4rpx 12rpx;color:#555}.label{display:block;font-weight:500;margin:28rpx 0 12rpx}.field,.picker{border:1rpx solid #d3d6d8;min-height:88rpx;box-sizing:border-box;padding:20rpx 22rpx;font-size:28rpx;border-radius:0;background:#fff}.picker{display:flex;align-items:center;justify-content:space-between}.picker:after{content:'⌄';color:#777}.textarea{border:1rpx solid #d3d6d8;padding:22rpx;box-sizing:border-box;width:100%;min-height:220rpx;font-size:26rpx}.check{display:flex;align-items:center;margin:20rpx 0;gap:16rpx}.check checkbox,.check radio{transform:scale(.85)}
button{margin:0;border-radius:0;font-size:27rpx;line-height:1.4;padding:25rpx 28rpx;font-weight:600;background:#252525;color:white;min-height:88rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center}button:after{border:0;border-radius:0}button[disabled]{background:#eee!important;color:#aaa!important}.secondary{background:#fff;color:#252525;border:1rpx solid #d9d9d9}.quiet{background:transparent;color:#555;padding:20rpx 4rpx;font-weight:400}.actions{display:flex;flex-wrap:wrap;gap:20rpx;margin:28rpx 0}.actions button{flex:1;min-width:240rpx}.dock{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1rpx solid #ddd;padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));z-index:10;display:flex;gap:16rpx}.dock button{flex:1}.cover{background:#f4f4f4;width:100%;height:440rpx;object-fit:contain}.book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36rpx 26rpx}.book-title{font-size:29rpx;font-weight:600;margin:14rpx 0 5rpx;line-height:1.45}.book-creator{font-size:24rpx;color:#777}.card{border-top:1rpx solid #333;padding:28rpx 0;margin:18rpx 0}.card-title{font-family:"Songti SC",serif;font-size:36rpx;margin:10rpx 0}.list-cover{width:130rpx;height:190rpx;flex:none;background:#f6f6f6}.progress-card{background:#f6f6f6;padding:26rpx;margin:18rpx 0}.segment{display:flex;gap:12rpx;margin:24rpx 0}.segment button{flex:1;min-height:74rpx;font-size:25rpx;padding:18rpx 12rpx}.theme-card{position:relative;overflow:hidden;background:#263237;color:white;margin:24rpx 0;padding:44rpx 32rpx;min-height:240rpx;box-sizing:border-box}.theme-number{font-size:23rpx;opacity:.6}.theme-title{font-family:"Songti SC",serif;font-size:44rpx;margin:20rpx 0}.theme-description{font-size:26rpx;color:#ddd}.note-box{padding:26rpx;background:#f5f5f4;margin:20rpx 0}.tab-scroll{white-space:nowrap;margin:20rpx 0}.tab-item{display:inline-block;padding:18rpx 24rpx;border-bottom:3rpx solid transparent;color:#777}.tab-item.active{border-bottom-color:#222;color:#222}.fact{display:flex;gap:24rpx;padding:16rpx 0;border-bottom:1rpx solid #eee}.fact-label{min-width:100rpx;color:#777}.weui-dialog__btn{color:#252525!important}

.theme-backdrop{position:absolute;top:0;left:0;width:100%;height:100%;opacity:.28}.theme-words{position:relative;z-index:1}


.club-masthead {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0 32rpx;
  border-bottom: 1px solid #d0d7da;
}
.club-signature { width: 192rpx; height: 38rpx; }
.club-opening {
  padding: 54rpx 0 44rpx;
  color: #172126;
  font: 400 54rpx/1.55 "Songti SC", "Noto Serif CJK SC", serif;
}
.club-opening text { display: block; }

.page.tab-page { padding-bottom: calc(52px + env(safe-area-inset-bottom) + 40rpx); }
.cover-row { display: flex; align-items: center; gap: 26rpx; }
.cover-row .card-title { margin-top: 8rpx; }
.cover-preview { margin: 20rpx 0; padding: 18rpx; background: #f4f4f0; }

/* Keep selector text readable at the same physical size on narrow phones. */
.picker { min-height: 48px; font-size: 17px; line-height: 1.45; overflow-wrap: anywhere; }

/* Shared form geometry: native controls must stay inside their content column. */
.page { box-sizing: border-box; max-width: 100%; }
.field, .textarea, .picker { width: 100%; max-width: 100%; min-width: 0; }
.field { height: 48px; padding-top: 0; padding-bottom: 0; }
.picker { gap: 12px; }
.picker:after { flex: none; }
.title, .subtitle, .card-title, .book-title, .fact { overflow-wrap: anywhere; }
.actions { align-items: stretch; }
.actions > button { width: 0; flex: 1 1 240rpx; }
.dock button { min-width: 0; width: 0; }
button { max-width: 100%; text-align: center; overflow-wrap: anywhere; }
.fact-label { flex: none; }
