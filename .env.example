# 通过 shell 环境变量提供配置；应用不会读取上级目录 .env。
CLUB_PORT=8787
# 仅启用 AI 时设置以下三个值，模型名称必须是服务支持的名称。
# AI_CHAT_URL=https://your-provider.example/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
# 部署到 HTTPS 反向代理后设置，默认只绑定 127.0.0.1。
# CLUB_SECURE_COOKIE=1
# 电影资料与图片刮削，使用 TMDB API Read Access Token。
# TMDB_TOKEN=
# 正式部署站点地址，用于同源和 Host 验证。
# CLUB_ORIGIN=https://club.example.com
