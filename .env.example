# 通过 shell 环境变量提供配置；应用不会读取上级目录 .env。
CLUB_PORT=8787
# 仅启用 AI 时设置以下三个值，模型名称必须是服务支持的名称。
# AI_CHAT_URL=https://your-provider.example/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
# 部署到 HTTPS 反向代理后设置，默认只绑定 127.0.0.1。
# CLUB_SECURE_COOKIE=1
# 电影资料与图片刮削，使用 TMDB API Read Access Token。
# TMDB_TOKEN=
# 如主域名从部署地区无法访问，可选择 api.tmdb.org；仅允许这两个 TMDB 域名。
# TMDB_API_HOST=api.themoviedb.org
# 正式部署站点地址，用于同源和 Host 验证。
# CLUB_ORIGIN=https://club.example.com
# 仅在应用监听回环地址、前方可信代理覆盖 X-Real-IP 时启用。
# CLUB_TRUST_PROXY=1
# 中文书籍优先使用微信读书官方 Agent Gateway（只启用书籍搜索和详情）。
# WEREAD_API_KEY=
# 备选图书版本来源：Google Books API Key。
# GOOGLE_BOOKS_KEY=
# Trakt 应用 Client ID：仅公开账号查询；私人账号可使用导出的 JSON。
# TRAKT_CLIENT_ID=
# 跨站评分补充（OMDb 标注为非商业许可）。
# OMDB_KEY=
# 向书籍数据源标识应用及真实联系方式，例如 Tongpin (contact@your-domain)。
# METADATA_USER_AGENT=
